# Copia este archivo como backend/.env y llena los valores. NUNCA subas el .env a GitHub.

NODE_ENV=development
PORT=4000

# Conexión de PostgreSQL. Si la dejas vacía, la API sirve el catálogo por defecto
# y las cotizaciones no se guardan (el cliente todavía puede escribir por WhatsApp).
DATABASE_URL=

# Conexiones simultáneas a la base (opcional, 5 por defecto).
DB_POOL_MAX=

# Sitios que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Token para /api/admin (mínimo 24 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
